# ── Nona environment variables ──
# Copy to .env.local for local dev
# On Vercel: paste each into Project Settings → Environment Variables

# NextAuth
NEXTAUTH_URL=https://your-app.vercel.app
NEXTAUTH_SECRET=generate-with: openssl rand -base64 32

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Google (Gmail OAuth)
# Create at: console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=....apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# Microsoft (Outlook OAuth via Microsoft Graph)
# Create at: portal.azure.com → App registrations → your app → "Certificates & secrets"
MICROSOFT_CLIENT_ID=...
MICROSOFT_CLIENT_SECRET=...

# Encrypts OAuth access/refresh tokens before they're stored in Supabase (lib/crypto.js, lib/tokens.js)
ENCRYPTION_KEY=generate-with: openssl rand -base64 32

# Supabase (login + cross-device sync — see supabase/*.sql)
# Get from: supabase.com → your project → Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...  # Never expose this publicly — server-side only

# Optional: max AI requests per user per day (triage/brief/task parsing combined).
# Guards against one account burning the whole shared ANTHROPIC_API_KEY budget.
# Defaults to 200 if unset.
DAILY_AI_LIMIT=200

# Web push (morning brief notification, ROADMAP.md P2 — pages/api/cron/morning-brief.js)
# Generate a pair with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is already read client-side by lib/push-client.js.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=...
VAPID_PRIVATE_KEY=...
# Contact address web-push puts in the push service request per the VAPID spec — any mailto: works.
VAPID_SUBJECT=mailto:you@example.com

# Authorizes calls to /api/cron/morning-brief. Vercel Cron sends this automatically
# as "Authorization: Bearer $CRON_SECRET" for the schedule configured in vercel.json —
# generate with: openssl rand -base64 32
CRON_SECRET=generate-with: openssl rand -base64 32
