# ── Nona environment variables ──
# Copy to .env.local for local dev
# On Vercel: paste each into Project Settings → Environment Variables

# NextAuth
NEXTAUTH_URL=https://your-app.vercel.app
NEXTAUTH_SECRET=generate-with: openssl rand -base64 32

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Google (Gmail OAuth)
# Create at: console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=....apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# Microsoft (Outlook OAuth via Microsoft Graph)
# Create at: portal.azure.com → App registrations → your app → "Certificates & secrets"
MICROSOFT_CLIENT_ID=...
MICROSOFT_CLIENT_SECRET=...

# Encrypts OAuth access/refresh tokens before they're stored in Supabase (lib/crypto.js, lib/tokens.js)
ENCRYPTION_KEY=generate-with: openssl rand -base64 32

# Supabase (login + cross-device sync — see supabase/*.sql)
# Get from: supabase.com → your project → Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...  # Never expose this publicly — server-side only

# Cloudflare Turnstile (bot protection on sign-in/signup — pages/login.js)
# Create at: dash.cloudflare.com → Turnstile → Add widget (domain: www.usenona.com,
# plus localhost for local testing). You get a Site Key and a Secret Key.
# Only the SITE key belongs here — the secret key goes into the Supabase dashboard
# (Authentication → Attack Protection), never into this repo or the browser.
# ORDER MATTERS: set this + redeploy FIRST, then enable CAPTCHA in Supabase.
# Enabling Supabase's toggle while this is unset rejects every sign-in attempt.
# Leave unset to disable Turnstile entirely — login works exactly as before.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
# The SECRET key. Supabase verifies Turnstile itself for login/signup, but our
# own routes (/api/contact, /api/mailing-list/subscribe) verify it server-side
# via lib/turnstile.js — without this set, those two skip verification, so the
# widget on those forms is decoration a bot can POST straight past.
# Same value you paste into Supabase → Authentication → Attack Protection.
TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# Optional: max AI requests per user per day (triage/brief/task parsing combined).
# Guards against one account burning the whole shared ANTHROPIC_API_KEY budget.
# Defaults to 200 if unset.
DAILY_AI_LIMIT=200

# Web push (morning brief notification, ROADMAP.md P2 — pages/api/cron/morning-brief.js)
# Generate a pair with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is already read client-side by lib/push-client.js.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=...
VAPID_PRIVATE_KEY=...
# Contact address web-push puts in the push service request per the VAPID spec — any mailto: works.
VAPID_SUBJECT=mailto:you@example.com

# Authorizes calls to /api/cron/morning-brief. Vercel Cron sends this automatically
# as "Authorization: Bearer $CRON_SECRET" for the schedule configured in vercel.json —
# generate with: openssl rand -base64 32
CRON_SECRET=generate-with: openssl rand -base64 32
